pcall(function()
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or queueonteleport
    if q then q('loadstring(game:HttpGet("https://raw.githubusercontent.com/philipptobe-crypto/farm/refs/heads/main/gifter"))()') end
end)
local Players = game:GetService("Players")
local WS = game:GetService("Workspace")
local LP = Players.LocalPlayer or Players.PlayerAdded:Wait()
local MainName = "dev_scripter912"
if string.lower(LP.Name) == string.lower(MainName) then return end
getgenv().AltGiftRun = (getgenv().AltGiftRun or 0) + 1
local myRun = getgenv().AltGiftRun

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/download/1.6.66/main.lua"))()
local Win = WindUI:CreateWindow({
    Title = "AltGift - " .. LP.Name,
    Icon = "gift",
    Author = "50% to main",
    Folder = "AltGift_" .. LP.Name,
    Size = UDim2.fromOffset(380, 280),
    Theme = "Dark",
    ToggleKey = Enum.KeyCode.K,
})
local Tab = Win:Tab({Title = "Gift", Icon = "gift"})
local autoGift = true
local autoReplay = true
local gifted = false
local unloaded = false
local status = Tab:Paragraph({Title = "idle", Desc = "warte game"})

local function gift50()
    local ok = pcall(function()
        local gui = LP.PlayerGui.GameGui.GiftCash
        firesignal(gui.All.Sell.Activated)
        task.wait(0.4)
        local btn = gui.Units:FindFirstChild(MainName):FindFirstChild("Gift")
        firesignal(btn.Activated)
    end)
    return ok
end
local function getReplay()
    local ok, b = pcall(function() return LP.PlayerGui.GameGui.EndScreen.Replay end)
    if not ok or typeof(b) ~= "Instance" then return nil end
    local ok2 = pcall(function() return b:IsA("GuiObject") and b.Visible and b.Parent.Visible end)
    if ok2 then return b end
    return nil
end

Tab:Toggle({Title = "Auto Gift bei Game Start", Value = true, Callback = function(s) autoGift = s end})
Tab:Button({Title = "Jetzt 50% giften", Callback = function() gifted = false gift50() gifted = true pcall(function() status:SetDesc("manuell gegiftet") end) end})
Tab:Toggle({Title = "Auto Replay", Value = true, Callback = function(s) autoReplay = s end})
Tab:Button({Title = "Replay jetzt", Callback = function()
    local b = getReplay()
    if b then pcall(function() firesignal(b.Activated) end) end
end})
Tab:Button({Title = "Unload Script", Callback = function()
    unloaded = true
    pcall(function() game:GetService("CoreGui"):FindFirstChild("AltGift_" .. LP.Name):Destroy() end)
    pcall(function() Win:Destroy() end)
end})

task.spawn(function()
    while true do
        task.wait(0.5)
        if unloaded or myRun ~= getgenv().AltGiftRun then break end
        if not WS:FindFirstChild("Towers") then
            gifted = false
            pcall(function() status:SetTitle("lobby") end)
        else
            pcall(function() status:SetTitle("ingame") end)
            if autoGift and not gifted then
                if gift50() then gifted = true pcall(function() status:SetDesc("auto 50% raus") end) end
            end
        end
    end
end)
task.spawn(function()
    while true do
        task.wait(1)
        if unloaded or myRun ~= getgenv().AltGiftRun then break end
        if autoReplay then
            local b = getReplay()
            if b then pcall(function() firesignal(b.Activated) end) end
        end
    end
end)
