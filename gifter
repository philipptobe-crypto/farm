-- AltGift mini - gurkenfarm1/2/4 -> dev_scripter912
local Players = game:GetService("Players")
local WS = game:GetService("Workspace")
local LP = Players.LocalPlayer or Players.PlayerAdded:Wait()
local MainName = "dev_scripter912"
if string.lower(LP.Name) == string.lower(MainName) then return end

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/download/1.6.66/main.lua"))()
local Win = WindUI:CreateWindow({
    Title = "AltGift - " .. LP.Name,
    Icon = "gift",
    Author = "50% to main",
    Folder = "AltGift_" .. LP.Name,
    Size = UDim2.fromOffset(360, 240),
    Theme = "Dark",
    ToggleKey = Enum.KeyCode.K,
})
local Tab = Win:Tab({Title = "Gift", Icon = "gift"})
local autoGift = true
local gifted = false
local status = Tab:Paragraph({Title = "idle", Desc = "warte game"})

local function gift50()
    local ok = pcall(function()
        local gui = LP.PlayerGui.GameGui.GiftCash
        firesignal(gui.All.Sell.Activated)
        task.wait(0.4)
        local btn = gui.Units:FindFirstChild(MainName):FindFirstChild("Gift")
        firesignal(btn.Activated)
    end)
    return ok
end

Tab:Toggle({Title = "Auto Gift bei Game Start", Value = true, Callback = function(s) autoGift = s end})
Tab:Button({Title = "Jetzt 50% giften", Callback = function() gifted = false gift50() gifted = true pcall(function() status:SetDesc("manuell gegiftet") end) end})

task.spawn(function()
    while true do
        task.wait(0.5)
        if not WS:FindFirstChild("Towers") then
            gifted = false
            pcall(function() status:SetTitle("lobby") end)
        else
            pcall(function() status:SetTitle("ingame") end)
            if autoGift and not gifted then
                if gift50() then gifted = true pcall(function() status:SetDesc("auto 50% raus") end) end
            end
        end
    end
end)
